FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

ARG VITE_CHORUS_MODE=direct
ARG VITE_CHORUS_ENABLED=true
ARG VITE_SHOW_DEV_TOOLS=false
ARG VITE_CHORUS_ENV=qualif
ARG VITE_DATA_API_BASE_URL=/api/db
ARG VITE_DATA_SUPPLIERS_PATH=/suppliers
ARG VITE_DATA_PUBLIC_CUSTOMERS_PATH=/public-customers
ARG VITE_DATA_PUBLIC_SERVICES_PATH=/public-services
ARG VITE_DATA_INVOICES_PATH=/invoices
ARG VITE_DATA_INVOICE_LINES_PATH=/invoice-lines
ARG VITE_REFERENCE_API_BASE_URL=/api/db
ARG VITE_REFERENCE_SUPPLIERS_PATH=/suppliers
ARG VITE_REFERENCE_PUBLIC_CUSTOMERS_PATH=/public-customers
ARG VITE_REFERENCE_PUBLIC_SERVICES_PATH=/public-services
ARG VITE_REFERENCE_ANNUAIRE_JSON_URL=/annuaire/annuaire.normalized.json
ARG VITE_REFERENCE_ANNUAIRE_XML_URL=
ARG VITE_CHORUS_CONNECTION_TEST_PATH=/v1/rechercher/fournisseur
ARG VITE_CHORUS_CONNECTION_TEST_METHOD=POST
ARG VITE_CHORUS_UPLOAD_FILE_PATH=/v1/ajouter/fichier
ARG VITE_CHORUS_SUBMIT_INVOICE_PATH=/v1/soumettre
ARG VITE_CHORUS_SUBMISSION_BRIDGE_URL=/api/chorus/submit
ARG VITE_CHORUS_SUBMISSION_CURRENT_USER_ID=
ARG VITE_CHORUS_SUBMISSION_SUPPLIER_ID=
ARG VITE_CHORUS_SUBMISSION_SUPPLIER_SERVICE_ID=
ARG VITE_CHORUS_SUBMISSION_BANK_ACCOUNT_CODE=
ARG VITE_CHORUS_PROD_SUBMISSION_CURRENT_USER_ID=
ARG VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_ID=
ARG VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_SERVICE_ID=
ARG VITE_CHORUS_PROD_SUBMISSION_BANK_ACCOUNT_CODE=
ARG VITE_CHORUS_QUALIF_SUBMISSION_CURRENT_USER_ID=
ARG VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_ID=
ARG VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_SERVICE_ID=
ARG VITE_CHORUS_QUALIF_SUBMISSION_BANK_ACCOUNT_CODE=
ARG VITE_CHORUS_SUBMISSION_CADRE_CODE=A1_FACTURE_FOURNISSEUR
ARG VITE_CHORUS_SUBMISSION_VALIDATOR_SERVICE_CODE=
ARG VITE_CHORUS_SUBMISSION_VALIDATOR_STRUCTURE_CODE=
ARG VITE_CHORUS_SUBMISSION_PAYMENT_MODE=VIREMENT
ARG VITE_CHORUS_SUBMISSION_INVOICE_TYPE=FACTURE
ARG VITE_CHORUS_SUBMISSION_VAT_TYPE=TVA_SUR_ENCAISSEMENT

ENV VITE_CHORUS_MODE=$VITE_CHORUS_MODE \
    VITE_CHORUS_ENABLED=$VITE_CHORUS_ENABLED \
    VITE_SHOW_DEV_TOOLS=$VITE_SHOW_DEV_TOOLS \
    VITE_CHORUS_ENV=$VITE_CHORUS_ENV \
    VITE_DATA_API_BASE_URL=$VITE_DATA_API_BASE_URL \
    VITE_DATA_SUPPLIERS_PATH=$VITE_DATA_SUPPLIERS_PATH \
    VITE_DATA_PUBLIC_CUSTOMERS_PATH=$VITE_DATA_PUBLIC_CUSTOMERS_PATH \
    VITE_DATA_PUBLIC_SERVICES_PATH=$VITE_DATA_PUBLIC_SERVICES_PATH \
    VITE_DATA_INVOICES_PATH=$VITE_DATA_INVOICES_PATH \
    VITE_DATA_INVOICE_LINES_PATH=$VITE_DATA_INVOICE_LINES_PATH \
    VITE_REFERENCE_API_BASE_URL=$VITE_REFERENCE_API_BASE_URL \
    VITE_REFERENCE_SUPPLIERS_PATH=$VITE_REFERENCE_SUPPLIERS_PATH \
    VITE_REFERENCE_PUBLIC_CUSTOMERS_PATH=$VITE_REFERENCE_PUBLIC_CUSTOMERS_PATH \
    VITE_REFERENCE_PUBLIC_SERVICES_PATH=$VITE_REFERENCE_PUBLIC_SERVICES_PATH \
    VITE_REFERENCE_ANNUAIRE_JSON_URL=$VITE_REFERENCE_ANNUAIRE_JSON_URL \
    VITE_REFERENCE_ANNUAIRE_XML_URL=$VITE_REFERENCE_ANNUAIRE_XML_URL \
    VITE_CHORUS_CONNECTION_TEST_PATH=$VITE_CHORUS_CONNECTION_TEST_PATH \
    VITE_CHORUS_CONNECTION_TEST_METHOD=$VITE_CHORUS_CONNECTION_TEST_METHOD \
    VITE_CHORUS_UPLOAD_FILE_PATH=$VITE_CHORUS_UPLOAD_FILE_PATH \
    VITE_CHORUS_SUBMIT_INVOICE_PATH=$VITE_CHORUS_SUBMIT_INVOICE_PATH \
    VITE_CHORUS_SUBMISSION_BRIDGE_URL=$VITE_CHORUS_SUBMISSION_BRIDGE_URL \
    VITE_CHORUS_SUBMISSION_CURRENT_USER_ID=$VITE_CHORUS_SUBMISSION_CURRENT_USER_ID \
    VITE_CHORUS_SUBMISSION_SUPPLIER_ID=$VITE_CHORUS_SUBMISSION_SUPPLIER_ID \
    VITE_CHORUS_SUBMISSION_SUPPLIER_SERVICE_ID=$VITE_CHORUS_SUBMISSION_SUPPLIER_SERVICE_ID \
    VITE_CHORUS_SUBMISSION_BANK_ACCOUNT_CODE=$VITE_CHORUS_SUBMISSION_BANK_ACCOUNT_CODE \
    VITE_CHORUS_PROD_SUBMISSION_CURRENT_USER_ID=$VITE_CHORUS_PROD_SUBMISSION_CURRENT_USER_ID \
    VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_ID=$VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_ID \
    VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_SERVICE_ID=$VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_SERVICE_ID \
    VITE_CHORUS_PROD_SUBMISSION_BANK_ACCOUNT_CODE=$VITE_CHORUS_PROD_SUBMISSION_BANK_ACCOUNT_CODE \
    VITE_CHORUS_QUALIF_SUBMISSION_CURRENT_USER_ID=$VITE_CHORUS_QUALIF_SUBMISSION_CURRENT_USER_ID \
    VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_ID=$VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_ID \
    VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_SERVICE_ID=$VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_SERVICE_ID \
    VITE_CHORUS_QUALIF_SUBMISSION_BANK_ACCOUNT_CODE=$VITE_CHORUS_QUALIF_SUBMISSION_BANK_ACCOUNT_CODE \
    VITE_CHORUS_SUBMISSION_CADRE_CODE=$VITE_CHORUS_SUBMISSION_CADRE_CODE \
    VITE_CHORUS_SUBMISSION_VALIDATOR_SERVICE_CODE=$VITE_CHORUS_SUBMISSION_VALIDATOR_SERVICE_CODE \
    VITE_CHORUS_SUBMISSION_VALIDATOR_STRUCTURE_CODE=$VITE_CHORUS_SUBMISSION_VALIDATOR_STRUCTURE_CODE \
    VITE_CHORUS_SUBMISSION_PAYMENT_MODE=$VITE_CHORUS_SUBMISSION_PAYMENT_MODE \
    VITE_CHORUS_SUBMISSION_INVOICE_TYPE=$VITE_CHORUS_SUBMISSION_INVOICE_TYPE \
    VITE_CHORUS_SUBMISSION_VAT_TYPE=$VITE_CHORUS_SUBMISSION_VAT_TYPE

RUN npm run build

FROM nginx:1.27-alpine

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1

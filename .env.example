# mock or direct
VITE_CHORUS_MODE=mock
VITE_CHORUS_ENABLED=false

# Python minimal Chorus submission flow
# CHORUS_BASE_URL must point to /cpro, not /cpro/factures
CHORUS_BASE_URL=https://sandbox-api.piste.gouv.fr/cpro
CHORUS_API_KEY=
CHORUS_CPRO_ACCOUNT=
CHORUS_TOKEN_URL=
CHORUS_CLIENT_ID=
CHORUS_CLIENT_SECRET=
CHORUS_SCOPE=openid
CHORUS_TIMEOUT_SECONDS=30
CHORUS_SUPPLIER_ID=26359578
CHORUS_CURRENT_USER_ID=
CHORUS_DESTINATAIRE_CODE=00000000113495
CHORUS_SERVICE_EXECUTANT_CODE=SERVICE_DESTINATAIRE25969476
CHORUS_BANK_ACCOUNT_CODE=

# OAuth2 PISTE sandbox
VITE_CHORUS_TOKEN_URL=https://sandbox-oauth.piste.gouv.fr/api/oauth/token
VITE_CHORUS_API_BASE_URL=https://sandbox-api.piste.gouv.fr/cpro/factures
VITE_REFERENCE_API_BASE_URL=
VITE_REFERENCE_SUPPLIERS_PATH=/test-data/suppliers.json
VITE_REFERENCE_PUBLIC_CUSTOMERS_PATH=/test-data/public-customers.json
VITE_REFERENCE_PUBLIC_SERVICES_PATH=/test-data/public-services.json
VITE_REFERENCE_ANNUAIRE_JSON_URL=/annuaire/annuaire.normalized.json
VITE_REFERENCE_ANNUAIRE_XML_URL=
VITE_DATA_API_BASE_URL=
VITE_DATA_TENANT_PATH=/test-data/tenant.current.json
VITE_DATA_CURRENT_USER_PATH=/test-data/users.me.json
VITE_DATA_SUPPLIERS_PATH=/test-data/suppliers.json
VITE_DATA_PUBLIC_CUSTOMERS_PATH=/test-data/public-customers.json
VITE_DATA_PUBLIC_SERVICES_PATH=/test-data/public-services.json
VITE_DATA_INVOICES_PATH=/test-data/invoices.json
VITE_DATA_INVOICE_LINES_PATH=/test-data/invoice-lines.json
VITE_DATA_INVOICE_ATTACHMENTS_PATH=/test-data/invoice-attachments.json
VITE_DATA_STATUS_HISTORY_PATH=/test-data/invoice-status-history.json
VITE_DATA_API_EXCHANGE_LOGS_PATH=/test-data/api-exchange-logs.json
VITE_DATA_ASYNC_JOBS_PATH=/test-data/async-jobs.json
VITE_DATA_AUDIT_LOGS_PATH=/test-data/audit-logs.json
VITE_DATA_EXTRACTION_RESULTS_PATH=/test-data/invoice-extraction-results.json
VITE_CHORUS_CLIENT_ID=
VITE_CHORUS_CLIENT_SECRET=
VITE_CHORUS_SCOPE=openid

# Chorus Pro technical account used in cpro-account
VITE_CHORUS_TECHNICAL_LOGIN=
VITE_CHORUS_TECHNICAL_PASSWORD=

# Connection test endpoint. Some Chorus endpoints only accept POST.
VITE_CHORUS_CONNECTION_TEST_PATH=/v1/rechercher/fournisseur
VITE_CHORUS_CONNECTION_TEST_METHOD=POST

# API endpoints for invoice upload / submission
VITE_CHORUS_UPLOAD_FILE_PATH=/v1/ajouter/fichier
VITE_CHORUS_SUBMIT_INVOICE_PATH=/v1/soumettre
VITE_CHORUS_SUBMISSION_BRIDGE_URL=http://127.0.0.1:8008/api/chorus/submit
VITE_CHORUS_USER_ACCOUNT_PATH=https://chorus-pro.gouv.fr:5443/service-qualif/utilisateurs/consulter/compte
VITE_CHORUS_USER_CONNECTIONS_PATH=https://chorus-pro.gouv.fr:5443/service-qualif/utilisateurs/monCompte/recuperer/rattachements

# Chorus submission context used to enrich the minimal /soumettre payload
VITE_CHORUS_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_SUBMISSION_SUPPLIER_ID=26359578
VITE_CHORUS_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_SUBMISSION_BANK_ACCOUNT_CODE=
VITE_CHORUS_SUBMISSION_CADRE_CODE=A1_FACTURE_FOURNISSEUR
VITE_CHORUS_SUBMISSION_VALIDATOR_SERVICE_CODE=
VITE_CHORUS_SUBMISSION_VALIDATOR_STRUCTURE_CODE=
VITE_CHORUS_SUBMISSION_PAYMENT_MODE=VIREMENT
VITE_CHORUS_SUBMISSION_INVOICE_TYPE=FACTURE
VITE_CHORUS_SUBMISSION_VAT_TYPE=TVA_SUR_ENCAISSEMENT
VITE_CHORUS_SUBMISSION_VAT_EXONERATION_REASON=
VITE_CHORUS_SUBMISSION_ORIGINAL_INVOICE_NUMBER=
VITE_CHORUS_SUBMISSION_COMMENT=

# Optional LLM extraction via Ollama
GEN_PROVIDER=ollama
GEN_BASE_URL=http://127.0.0.1:11434
GEN_MODEL=qwen2.5:14b-instruct
GEN_MAX_NEW_TOKENS=8000
GEN_TEMPERATURE=0.2
GEN_TOP_P=0.9

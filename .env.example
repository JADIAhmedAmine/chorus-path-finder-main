# mock or direct
VITE_CHORUS_MODE=mock
VITE_CHORUS_ENABLED=false
VITE_SHOW_DEV_TOOLS=false

# Chorus environment: "qualif" (sandbox PISTE) or "prod" (production PISTE).
# Drives the default token URL, API base URL, and Chorus user-services URLs
# when the corresponding *_URL / *_PATH variables below are left empty.
# Explicit URL values (set below) always override these presets.
CHORUS_ENV=qualif
VITE_CHORUS_ENV=qualif

# Python minimal Chorus submission flow
# CHORUS_BASE_URL must point to /cpro, not /cpro/factures
# Leave empty to derive from CHORUS_ENV.
CHORUS_BASE_URL=
CHORUS_API_KEY=
CHORUS_CPRO_ACCOUNT=
CHORUS_TOKEN_URL=
CHORUS_CLIENT_ID=
CHORUS_CLIENT_SECRET=
CHORUS_TECHNICAL_LOGIN=
CHORUS_TECHNICAL_PASSWORD=
CHORUS_SCOPE=openid
CHORUS_TIMEOUT_SECONDS=30
CHORUS_SUPPLIER_ID=
CHORUS_CURRENT_USER_ID=

# --- Pré-contrôle métier du dépôt de flux (chorus_flux_business_validator) ---
# IMPORTANT : le champ XML AccountingSupplierParty.Party.PartyIdentification.ID
# est un identifiant MÉTIER (SIRET attendu). Il ne doit jamais être comparé à un
# identifiant interne Chorus (ligne du portail).
#
# SIRET (14 chiffres) des structures fournisseur autorisées à déposer. Si la
# liste est renseignée et le mode strict actif, un SIRET fournisseur absent de la
# liste bloque le dépôt. Séparateurs: virgule/espace/point-virgule.
CHORUS_ALLOWED_SUPPLIER_SIRETS=
# IDs internes Chorus (référence portail) — informatif, JAMAIS utilisé pour
# valider le SIRET du XML.
CHORUS_ALLOWED_SUPPLIER_INTERNAL_IDS=
# SIRET fournisseur par défaut proposé dans les corrections.
CHORUS_DEFAULT_SUPPLIER_SIRET=
# La structure fournisseur est-elle habilitée à l'application "Demandes de paiement" ?
CHORUS_SUPPLIER_DP_ENABLED=false
# Mode strict: en true, un SIRET fournisseur absent/non autorisé bloque; en false
# c'est un avertissement. Les champs métier obligatoires manquants (identifiants/
# adresses) bloquent dans tous les cas.
CHORUS_STRICT_BUSINESS_VALIDATION=false
#
# Rétro-compat : si CHORUS_ALLOWED_SUPPLIER_SIRETS est absent, l'ancien
# CHORUS_ALLOWED_SUPPLIER_IDENTIFIERS sert d'allowlist SIRET ; l'ancien
# CHORUS_ALLOWED_SUPPLIER_IDS est interprété comme IDs internes (informatif).
CHORUS_ALLOWED_SUPPLIER_IDENTIFIERS=
CHORUS_DEFAULT_SUPPLIER_IDENTIFIER=

# --- Module G2B (extension séparée — ne remplace pas /v1/deposer/flux) ---
# URLs de base (sandbox par défaut ; surcharger pour la production).
G2B_FLUX_BASE_URL=https://sandbox-api.piste.gouv.fr/g2b/flux/v1
G2B_ANNUAIRE_BASE_URL=https://sandbox-api.piste.gouv.fr/g2b/annuaire/v1
G2B_RACCORDEMENT_BASE_URL=https://sandbox-api.piste.gouv.fr/g2b/raccordements/v1
# Mode de calcul du checksum du flux G2B : raw (sha256 du fichier) ou base64.
G2B_FLUX_CHECKSUM_MODE=raw
# Active l'appel Annuaire G2B dans le pré-contrôle métier du dépôt historique
# (sinon la validation destinataire reste à la demande via /api/g2b/annuaire/validate-recipient).
G2B_ANNUAIRE_ENABLED=false
# Config fournisseur G2B (repli rétro-compatible sur les CHORUS_* ci-dessus).
G2B_ALLOWED_SUPPLIER_SIRETS=
G2B_DEFAULT_SUPPLIER_SIRET=
G2B_SUPPLIER_INTERNAL_IDS=
G2B_SUPPLIER_DP_ENABLED=false
G2B_STRICT_BUSINESS_VALIDATION=false
G2B_STRICT_ANNUAIRE_VALIDATION=false
G2B_STRICT_SERVICE_CODE_VALIDATION=false
G2B_STRICT_ENGAGEMENT_VALIDATION=false
CHORUS_DESTINATAIRE_CODE=00000000113495
CHORUS_SERVICE_EXECUTANT_CODE=SERVICE_DESTINATAIRE25969476
CHORUS_BANK_ACCOUNT_CODE=

# URLs publiques PISTE — leave empty to derive from VITE_CHORUS_ENV (qualif/prod presets).
VITE_CHORUS_TOKEN_URL=
VITE_CHORUS_API_BASE_URL=
VITE_REFERENCE_API_BASE_URL=/api/db
VITE_REFERENCE_SUPPLIERS_PATH=/suppliers
VITE_REFERENCE_PUBLIC_CUSTOMERS_PATH=/public-customers
VITE_REFERENCE_PUBLIC_SERVICES_PATH=/public-services
VITE_REFERENCE_ANNUAIRE_JSON_URL=/annuaire/annuaire.normalized.json
VITE_REFERENCE_ANNUAIRE_XML_URL=
VITE_DATA_API_BASE_URL=
VITE_DATA_TENANT_PATH=/test-data/tenant.current.json
VITE_DATA_CURRENT_USER_PATH=/test-data/users.me.json
VITE_DATA_SUPPLIERS_PATH=/test-data/suppliers.json
VITE_DATA_PUBLIC_CUSTOMERS_PATH=/test-data/public-customers.json
VITE_DATA_PUBLIC_SERVICES_PATH=/test-data/public-services.json
VITE_DATA_INVOICES_PATH=/test-data/invoices.json
VITE_DATA_INVOICE_LINES_PATH=/test-data/invoice-lines.json
VITE_DATA_INVOICE_ATTACHMENTS_PATH=/test-data/invoice-attachments.json
VITE_DATA_STATUS_HISTORY_PATH=/test-data/invoice-status-history.json
VITE_DATA_API_EXCHANGE_LOGS_PATH=/test-data/api-exchange-logs.json
VITE_DATA_ASYNC_JOBS_PATH=/test-data/async-jobs.json
VITE_DATA_AUDIT_LOGS_PATH=/test-data/audit-logs.json
VITE_DATA_EXTRACTION_RESULTS_PATH=/test-data/invoice-extraction-results.json

# Frontend container port exposed by docker-compose.prod.yml
APP_HTTP_PORT=8081

# Local Vite dev server port
VITE_DEV_SERVER_PORT=8081

# Comma-separated allowed browser origins for FastAPI CORS.
# Use your final HTTPS origin in production, e.g. https://chorus.example.com.
APP_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ----------------------------------------------------------------------------
# Application auth (master password, server-side only)
# ----------------------------------------------------------------------------
# Generate a bcrypt hash:
# python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt(rounds=12)).decode())"
# Generate a JWT secret:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_AUTH_EMAIL=admin@chorus.local
APP_AUTH_PASSWORD_HASH=
APP_AUTH_JWT_SECRET=
APP_AUTH_TOKEN_TTL_SECONDS=43200
# ----------------------------------------------------------------------------
# Credentials par environnement, côté serveur uniquement
# (sélectionnés via CHORUS_ENV / VITE_CHORUS_ENV).
# Les variables suffixées _QUALIF_ / _PROD_ écrasent les variables non suffixées
# pour l'environnement actif. Les non-suffixées servent de fallback.
# ----------------------------------------------------------------------------
# Qualification (sandbox PISTE) — contexte non secret exposable au front
VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_ID=
VITE_CHORUS_QUALIF_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_QUALIF_SUBMISSION_BANK_ACCOUNT_CODE=

# Côté serveur — qualif
CHORUS_QUALIF_CLIENT_ID=
CHORUS_QUALIF_CLIENT_SECRET=
CHORUS_QUALIF_TECHNICAL_LOGIN=
CHORUS_QUALIF_TECHNICAL_PASSWORD=
CHORUS_QUALIF_API_KEY=
CHORUS_QUALIF_CPRO_ACCOUNT=
CHORUS_QUALIF_SUPPLIER_ID=
CHORUS_QUALIF_DESTINATAIRE_CODE=
CHORUS_QUALIF_SERVICE_EXECUTANT_CODE=
CHORUS_QUALIF_BANK_ACCOUNT_CODE=

# Production (PISTE) — contexte non secret exposable au front
VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_ID=
VITE_CHORUS_PROD_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_PROD_SUBMISSION_BANK_ACCOUNT_CODE=

# Côté serveur — prod
CHORUS_PROD_CLIENT_ID=
CHORUS_PROD_CLIENT_SECRET=
CHORUS_PROD_TECHNICAL_LOGIN=
CHORUS_PROD_TECHNICAL_PASSWORD=
CHORUS_PROD_API_KEY=
CHORUS_PROD_CPRO_ACCOUNT=
CHORUS_PROD_SUPPLIER_ID=
CHORUS_PROD_DESTINATAIRE_CODE=
CHORUS_PROD_SERVICE_EXECUTANT_CODE=
CHORUS_PROD_BANK_ACCOUNT_CODE=

# Fallback non suffixé exposable au front
VITE_CHORUS_SCOPE=openid

# Connection test endpoint. Some Chorus endpoints only accept POST.
VITE_CHORUS_CONNECTION_TEST_PATH=/v1/rechercher/fournisseur
VITE_CHORUS_CONNECTION_TEST_METHOD=POST

# API endpoints for invoice upload / submission
VITE_CHORUS_UPLOAD_FILE_PATH=/v1/ajouter/fichier
VITE_CHORUS_SUBMIT_INVOICE_PATH=/v1/soumettre
VITE_CHORUS_SUBMISSION_BRIDGE_URL=http://127.0.0.1:8008/api/chorus/submit
# Chorus user services — leave empty to derive from VITE_CHORUS_ENV
# (qualif => /service-qualif/, prod => /service/).
VITE_CHORUS_USER_ACCOUNT_PATH=
VITE_CHORUS_USER_CONNECTIONS_PATH=

# Chorus submission context used to enrich the minimal /soumettre payload
VITE_CHORUS_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_SUBMISSION_SUPPLIER_ID=
VITE_CHORUS_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_SUBMISSION_BANK_ACCOUNT_CODE=
VITE_CHORUS_SUBMISSION_CADRE_CODE=A1_FACTURE_FOURNISSEUR
VITE_CHORUS_SUBMISSION_VALIDATOR_SERVICE_CODE=
VITE_CHORUS_SUBMISSION_VALIDATOR_STRUCTURE_CODE=
VITE_CHORUS_SUBMISSION_PAYMENT_MODE=VIREMENT
VITE_CHORUS_SUBMISSION_INVOICE_TYPE=FACTURE
VITE_CHORUS_SUBMISSION_VAT_TYPE=TVA_SUR_DEBIT
VITE_CHORUS_SUBMISSION_VAT_EXONERATION_REASON=
VITE_CHORUS_SUBMISSION_ORIGINAL_INVOICE_NUMBER=
VITE_CHORUS_SUBMISSION_COMMENT=

# PDF extraction. Keep `local` for PyMuPDF + pdfplumber only.
# Use `docling` when DOCLING_SERVER_URL points to a Docling server.
PDF_EXTRACTION_ENGINE=local
DOCLING_SERVER_URL=
DOCLING_TIMEOUT=1800
DOCLING_ENABLE_PICTURE_DESCRIPTION=false

# Invoice field extraction is regex/template-only by default.
# Leave GEN_PROVIDER empty so no browser-side LLM extraction is used.
GEN_PROVIDER=
GEN_BASE_URL=
GEN_MODEL=
GEN_MAX_NEW_TOKENS=8000
GEN_TEMPERATURE=0.2
GEN_TOP_P=0.9

# ----------------------------------------------------------------------------
# PostgreSQL database (used by /api/db/* and Chorus -> DB synchronization)
# ----------------------------------------------------------------------------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://chorus:chorus@localhost:5432/chorus
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_ECHO_SQL=false

# Used by docker-compose to provision the postgres container
POSTGRES_USER=chorus
POSTGRES_PASSWORD=chorus
POSTGRES_DB=chorus

# Default tenant id used when API callers do not provide one
CHORUS_DEFAULT_TENANT_ID=tenant-gigalis-default

# ----------------------------------------------------------------------------
# Background Chorus -> DB synchronization (APScheduler)
# ----------------------------------------------------------------------------
SYNC_STARTUP_FULL_SYNC=true
SYNC_CRON_ENABLED=false
SYNC_CRON_INTERVAL_SECONDS=300
SYNC_CRON_MODE=delta
SYNC_CRON_PAGE_SIZE=100
# Refresh the supplier list every N ticks (defaults to 12 -> ~1h with 5min cron)
SYNC_CRON_SUPPLIERS_EVERY_N_RUNS=12
# Optional override of the Chorus environment used by the cron (qualif/production)
SYNC_CRON_ENVIRONMENT=

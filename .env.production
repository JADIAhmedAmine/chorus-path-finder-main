# ============================================================================
# Chorus Path Finder — local environment
# ============================================================================
# Switch entre qualif (sandbox PISTE) et prod (production PISTE).
# Les URLs *_URL / *_PATH dérivent automatiquement de cette valeur quand vides.
# Les credentials suffixés _QUALIF_ / _PROD_ ci-dessous sont sélectionnés
# automatiquement selon l'env actif. Les variables non suffixées restent
# un fallback (rétrocompatibilité).


# =============================================================================
#Version de cache pour forcer le rafraîchissement des assets (incrémenter à chaque déploiement)
# ============================================================================
#VITE_CACHE_VERSION=v2


CHORUS_ENV=prod
VITE_CHORUS_ENV=prod

# Mode connecteur Chorus
VITE_CHORUS_MODE=direct
VITE_CHORUS_ENABLED=true
VITE_SHOW_DEV_TOOLS=true

# ----------------------------------------------------------------------------
# OAuth2 PISTE — laissées vides pour dériver de CHORUS_ENV
# qualif => https://sandbox-oauth.piste.gouv.fr / sandbox-api.piste.gouv.fr
# prod   => https://oauth.piste.gouv.fr / api.piste.gouv.fr
# ----------------------------------------------------------------------------
VITE_CHORUS_TOKEN_URL=
VITE_CHORUS_API_BASE_URL=  
VITE_CHORUS_SCOPE=openid

# ============================================================================
# Credentials par environnement (sélectionnés via CHORUS_ENV / VITE_CHORUS_ENV)
# ============================================================================

# ---- QUALIFICATION (sandbox PISTE) ----
VITE_CHORUS_QUALIF_CLIENT_ID=593ef6d9-801e-4a17-8aec-92e1f5a6e9e0
VITE_CHORUS_QUALIF_CLIENT_SECRET=57bef348-38bb-4894-b6a9-16b7951dc7ae
VITE_CHORUS_QUALIF_TECHNICAL_LOGIN=TECH_2_32242033407300@cpro.fr
VITE_CHORUS_QUALIF_TECHNICAL_PASSWORD=xgFpkx!gagyr8
VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_ID=26359578
VITE_CHORUS_QUALIF_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_QUALIF_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_QUALIF_SUBMISSION_BANK_ACCOUNT_CODE=

# Côté Python (CLI submit_chorus_invoice.py) — équivalents qualif
CHORUS_QUALIF_API_KEY=
CHORUS_QUALIF_CPRO_ACCOUNT=
CHORUS_QUALIF_SUPPLIER_ID=26359578
CHORUS_QUALIF_DESTINATAIRE_CODE=00000000113495
CHORUS_QUALIF_SERVICE_EXECUTANT_CODE=SERVICE_DESTINATAIRE25969476
CHORUS_QUALIF_BANK_ACCOUNT_CODE=

# ---- PRODUCTION ----
# A renseigner avec les credentials PISTE prod (différents de la qualif).
VITE_CHORUS_PROD_CLIENT_ID=fcc0144d-0376-4b37-b136-e3a0265c7ecf
VITE_CHORUS_PROD_CLIENT_SECRET=2a292fc4-dc03-4dae-8903-7ed8c0abd6b5
VITE_CHORUS_PROD_TECHNICAL_LOGIN=TECH_3_25440253000011@cpro.fr
VITE_CHORUS_PROD_TECHNICAL_PASSWORD='mpog5utgeK$$ju'
VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_ID=891186
VITE_CHORUS_PROD_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_PROD_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_PROD_SUBMISSION_BANK_ACCOUNT_CODE=

# Côté Python — équivalents prod
CHORUS_PROD_API_KEY=
CHORUS_PROD_CPRO_ACCOUNT=
CHORUS_PROD_SUPPLIER_ID=891186
CHORUS_PROD_DESTINATAIRE_CODE=
CHORUS_PROD_SERVICE_EXECUTANT_CODE=
CHORUS_PROD_BANK_ACCOUNT_CODE=

# ---- Fallbacks non suffixés (rétrocompat — utilisés si _QUALIF_/_PROD_ vides) ----
VITE_CHORUS_CLIENT_ID=
VITE_CHORUS_CLIENT_SECRET=
VITE_CHORUS_TECHNICAL_LOGIN=
VITE_CHORUS_TECHNICAL_PASSWORD=

# ----------------------------------------------------------------------------
# Endpoints Chorus (paths relatifs à VITE_CHORUS_API_BASE_URL)
# ----------------------------------------------------------------------------
VITE_CHORUS_CONNECTION_TEST_PATH=/v1/rechercher/fournisseur
VITE_CHORUS_CONNECTION_TEST_METHOD=POST
VITE_CHORUS_UPLOAD_FILE_PATH=/v1/deposer/pdf
VITE_CHORUS_SUBMIT_INVOICE_PATH=/v1/soumettre

# Chorus user services — laissées vides pour dériver de VITE_CHORUS_ENV
VITE_CHORUS_USER_ACCOUNT_PATH=
VITE_CHORUS_USER_CONNECTIONS_PATH=

# Pont Python local pour soumission (évite CORS depuis le navigateur)
VITE_CHORUS_SUBMISSION_BRIDGE_URL=/api/chorus/submit

# ----------------------------------------------------------------------------
# Contexte Chorus (paramètres métier non secrets, identiques qualif/prod)
# ----------------------------------------------------------------------------
VITE_CHORUS_SUBMISSION_CADRE_CODE=A1_FACTURE_FOURNISSEUR
VITE_CHORUS_SUBMISSION_VALIDATOR_SERVICE_CODE=
VITE_CHORUS_SUBMISSION_VALIDATOR_STRUCTURE_CODE=
VITE_CHORUS_SUBMISSION_PAYMENT_MODE=CHEQUE
VITE_CHORUS_SUBMISSION_INVOICE_TYPE=FACTURE
VITE_CHORUS_SUBMISSION_VAT_TYPE=AUTO
VITE_CHORUS_SUBMISSION_VAT_EXONERATION_REASON=
VITE_CHORUS_SUBMISSION_ORIGINAL_INVOICE_NUMBER=
VITE_CHORUS_SUBMISSION_COMMENT=

# Fallbacks submission non suffixés
VITE_CHORUS_SUBMISSION_SUPPLIER_ID=26359578
VITE_CHORUS_SUBMISSION_CURRENT_USER_ID=
VITE_CHORUS_SUBMISSION_SUPPLIER_SERVICE_ID=
VITE_CHORUS_SUBMISSION_BANK_ACCOUNT_CODE=

# ----------------------------------------------------------------------------
# Référentiels frontend (annuaire + données de test)
# ----------------------------------------------------------------------------
VITE_REFERENCE_API_BASE_URL=/api/db
VITE_REFERENCE_SUPPLIERS_PATH=/suppliers
VITE_REFERENCE_PUBLIC_CUSTOMERS_PATH=/public-customers
VITE_REFERENCE_PUBLIC_SERVICES_PATH=/public-services
VITE_REFERENCE_ANNUAIRE_JSON_URL=/annuaire/annuaire.normalized.json
VITE_REFERENCE_ANNUAIRE_XML_URL=

# Données applicatives (façade JSON statique en local)
VITE_DATA_API_BASE_URL=
VITE_DATA_TENANT_PATH=/test-data/tenant.current.json
VITE_DATA_CURRENT_USER_PATH=/test-data/users.me.json
VITE_DATA_SUPPLIERS_PATH=/test-data/suppliers.json
VITE_DATA_PUBLIC_CUSTOMERS_PATH=/test-data/public-customers.json
VITE_DATA_PUBLIC_SERVICES_PATH=/test-data/public-services.json
VITE_DATA_INVOICES_PATH=/test-data/invoices.json
VITE_DATA_INVOICE_LINES_PATH=/test-data/invoice-lines.json
VITE_DATA_INVOICE_ATTACHMENTS_PATH=/test-data/invoice-attachments.json
VITE_DATA_STATUS_HISTORY_PATH=/test-data/invoice-status-history.json
VITE_DATA_API_EXCHANGE_LOGS_PATH=/test-data/api-exchange-logs.json
VITE_DATA_ASYNC_JOBS_PATH=/test-data/async-jobs.json
VITE_DATA_AUDIT_LOGS_PATH=/test-data/audit-logs.json
VITE_DATA_EXTRACTION_RESULTS_PATH=/test-data/invoice-extraction-results.json

# ============================================================================
# Côté Python — variables génériques (rétrocompat)
# ============================================================================
# Si CHORUS_BASE_URL / CHORUS_TOKEN_URL sont vides, ils dérivent de CHORUS_ENV.
CHORUS_BASE_URL=
CHORUS_TOKEN_URL=
CHORUS_SCOPE=openid
CHORUS_TIMEOUT_SECONDS=30
CHORUS_API_KEY=
CHORUS_CPRO_ACCOUNT=
CHORUS_CLIENT_ID=
CHORUS_CLIENT_SECRET=
CHORUS_SUPPLIER_ID=
CHORUS_CURRENT_USER_ID=
CHORUS_DESTINATAIRE_CODE=
CHORUS_SERVICE_EXECUTANT_CODE=
CHORUS_BANK_ACCOUNT_CODE=

# ============================================================================
# Extraction LLM (vllm) + Docling
# ============================================================================
GEN_PROVIDER=vllm
GEN_BASE_URL=http://192.168.150.50:8000/v1
GEN_MODEL=openai/gpt-oss-20b
GEN_MAX_NEW_TOKENS=1024
GEN_TEMPERATURE=0.2
GEN_TOP_P=0.9

DOCLING_SERVER_URL=http://192.168.150.50:11437/convert/upload
DOCLING_TIMEOUT=1800
DOCLING_ENABLE_PICTURE_DESCRIPTION=false

# ----------------------------------------------------------------------------
# PostgreSQL database (used by /api/db/* and Chorus -> DB synchronization)
# ----------------------------------------------------------------------------
# Quand le serveur tourne en local (hors docker-compose):
DATABASE_URL=postgresql+psycopg://chorus:chorus@localhost:5432/chorus
# Quand le serveur tourne dans docker-compose, surcharge dans compose:
#   postgresql+psycopg://chorus:chorus@postgres:5432/chorus
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_ECHO_SQL=false

# Variables consommées par le service postgres de docker-compose
POSTGRES_USER=chorus
POSTGRES_PASSWORD=chorus
POSTGRES_DB=chorus

# Tenant par défaut utilisé quand l'appelant API n'en fournit pas
CHORUS_DEFAULT_TENANT_ID=tenant-gigalis-default

# Liste blanche des idStructureCPP Chorus à synchroniser (CSV).
# Vide = pas de filtre. Les structures hors whitelist sont marquées active=false
# et ne sont pas synchronisées (ni cron, ni endpoint API).
CHORUS_ALLOWED_SUPPLIER_IDS=891186

# ----------------------------------------------------------------------------
# Synchronisation Chorus -> DB en tâche de fond (APScheduler)
# ----------------------------------------------------------------------------
# Mets SYNC_CRON_ENABLED=true pour activer le cron au démarrage du serveur
SYNC_CRON_ENABLED=true
SYNC_CRON_INTERVAL_SECONDS=300
SYNC_CRON_MODE=delta
SYNC_CRON_PAGE_SIZE=3000
SYNC_CRON_SUPPLIERS_EVERY_N_RUNS=12
SYNC_CRON_ENVIRONMENT=

# ----------------------------------------------------------------------------
# Frontend -> backend DB API (via le proxy Vite /api -> 127.0.0.1:8008)
# ----------------------------------------------------------------------------
# Active la lecture des données depuis Postgres au lieu des JSON statiques
VITE_DATA_API_BASE_URL=/api/db
VITE_DATA_SUPPLIERS_PATH=/suppliers
VITE_DATA_PUBLIC_CUSTOMERS_PATH=/public-customers
VITE_DATA_PUBLIC_SERVICES_PATH=/public-services
VITE_DATA_INVOICES_PATH=/invoices
VITE_DATA_INVOICE_LINES_PATH=/invoice-lines
# Endpoints non encore servis par le backend DB (le frontend retombera sur ses fallbacks)
VITE_DATA_TENANT_PATH=
VITE_DATA_CURRENT_USER_PATH=
VITE_DATA_INVOICE_ATTACHMENTS_PATH=
VITE_DATA_STATUS_HISTORY_PATH=
VITE_DATA_API_EXCHANGE_LOGS_PATH=
VITE_DATA_ASYNC_JOBS_PATH=
VITE_DATA_AUDIT_LOGS_PATH=
VITE_DATA_EXTRACTION_RESULTS_PATH=

# Cible du proxy Vite pour /api -> backend FastAPI
VITE_BACKEND_API_TARGET=http://127.0.0.1:8008

# Désactive complètement l'affichage du body (garde juste status + codeRetour)
CHORUS_DEBUG_PRINT_RESPONSE=true

# Limite la taille du body affiché (défaut: 8000 chars). 0 = pas de limite.
CHORUS_DEBUG_RESPONSE_MAX_CHARS=8000

# ----------------------------------------------------------------------------
# Application auth (mot de passe maître)
# ----------------------------------------------------------------------------
# Login temporaire: admin@chorus.local / MOT_DE_PASSE_TEMPORAIRE
# Remplace ce mot de passe avant partage réseau ou pré-prod.
APP_AUTH_EMAIL=admin@chorus.local
APP_AUTH_PASSWORD_HASH='$2b$12$Fzj2GXirc/cd.c5bjiBJ.OwwjgiYBBfursNd0rdG6E3vrXdeRsHeS'
APP_AUTH_JWT_SECRET=E7ysgwFiAS7vgPpco3KHiJdyC1D7j8nbQ57A278WaC_F1ySyodaZJDASKUFccMZm
APP_AUTH_TOKEN_TTL_SECONDS=43200
APP_MOT_DE_PASSE_TEMPORAIRE=MOT_DE_PASSE_TEMPORAIRE
